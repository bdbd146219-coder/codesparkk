# Base URL of the backend API (used by the shared API client).
VITE_API_BASE_URL=http://localhost:5000

# Base that serves catalog media storage keys (thumbnails / heroes). The backend
# exposes a public, read-only, image-only endpoint at GET /api/v1/media/{key}
# (C4F). Point this at it to render real images:
#   dev (cross-origin):   http://localhost:5234/api/v1/media
#   prod (same-origin):   /api/v1/media
# Or a CDN origin if you front the storage with one.
# LEAVE EMPTY to keep the branded Code Spark Kids fallback tile everywhere — the
# UI never fabricates a URL or exposes a private storage path. See docs/roadmap.md.
VITE_MEDIA_BASE_URL=
